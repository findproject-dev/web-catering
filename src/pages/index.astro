---
import Layout from '../layouts/Layout.astro';
import { BRAND_INFO, SERVICES_LIST, BEST_SELLERS, PACKAGES_LIST, WHY_US_LIST, TESTIMONIALS_LIST, QUALITY_BADGES, SEMARANG_DISTRICTS } from '../data/cateringData';
import { getWhatsAppUrl } from '../utils/whatsapp';

const generalWaUrl = getWhatsAppUrl('general');
const featuredPackages = PACKAGES_LIST.filter(p => p.isPopular).slice(0, 3);
const pricelistWaUrl = `https://wa.me/${BRAND_INFO.whatsappNumber}?text=${encodeURIComponent('Halo FindSeleroo, saya ingin meminta file brosur dan pricelist lengkap catering untuk referensi acara/kantor saya. Terima kasih!')}`;
---

<Layout
  title="FindSeleroo — Catering Premium Semarang | Hidangan Istimewa, Momen Lebih Bermakna"
  description="Layanan catering premium di Semarang untuk kebutuhan harian, makan keluarga, nasi box kantor, dan prasmanan event perayaan. Rasa otentik, higienis & terpercaya."
  currentPath="/"
>
  <!-- 1. HERO SECTION -->
  <section class="relative bg-[#263A30] text-[#F4EBDD] overflow-hidden">
    <!-- Subtle background gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#1b2b23] via-[#263A30]/90 to-transparent z-10"></div>
    
    <!-- Background Image -->
    <div class="absolute inset-0 z-0 opacity-40">
      <img
        src="https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=1920&q=85"
        alt="Sajian Hidangan Catering Premium FindSeleroo Semarang"
        class="w-full h-full object-cover object-center scale-105"
        loading="eager"
      />
    </div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[#B78B5B]/20 border border-[#B78B5B]/40 text-[#B78B5B] text-xs font-semibold tracking-widest uppercase mb-6">
          Premium Catering Semarang
        </span>
        
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#F4EBDD] leading-[1.15] mb-6">
          {BRAND_INFO.tagline}
        </h1>

        <p class="text-base sm:text-lg text-[#F4EBDD]/85 leading-relaxed mb-10 max-w-xl">
          {BRAND_INFO.subTagline}
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/menu"
            class="inline-flex items-center justify-center px-8 py-3.5 bg-[#B78B5B] hover:bg-[#a67c4e] text-[#263A30] font-semibold text-sm tracking-wide transition-all shadow-md hover:shadow-lg rounded-xs"
          >
            Lihat Pilihan Menu
          </a>
          <a
            href={generalWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-transparent hover:bg-[#F4EBDD] text-[#F4EBDD] hover:text-[#263A30] border-2 border-[#F4EBDD] font-medium text-sm tracking-wide transition-all rounded-xs"
          >
            <svg class="w-4 h-4 text-emerald-400 group-hover:text-[#263A30]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.45 1.014 1.157 1.644.912.812 1.637 1.059 1.868 1.175.231.116.368.102.506-.058.138-.16.592-.693.75-0.93.159-.237.318-.198.535-.116.217.082 1.372.646 1.609.764.237.118.395.176.453.275.058.099.058.577-.086.982z"/>
            </svg>
            <span>Pesan Sekarang</span>
          </a>
        </div>

        <!-- Minimum Order Banner -->
        <div class="mt-8 flex items-center gap-2 text-xs text-[#F4EBDD]/70">
          <svg class="w-4 h-4 text-[#B78B5B]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{BRAND_INFO.minOrderRule} Melayani seluruh wilayah Kota Semarang.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Trust Badges Section -->
  <section class="py-8 bg-[#1e2f26] border-y border-[#B78B5B]/20 text-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {QUALITY_BADGES.map((badge) => (
          <div class="flex items-start gap-3">
            <div class="w-2.5 h-2.5 rounded-full bg-[#B78B5B] mt-1 shrink-0"></div>
            <div>
              <h4 class="font-serif font-bold text-sm text-[#F4EBDD]">{badge.title}</h4>
              <p class="text-xs text-[#F4EBDD]/70 mt-0.5 leading-snug">{badge.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. BRAND INTRODUCTION -->
  <section class="py-20 sm:py-28 bg-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Image Composition -->
        <div class="lg:col-span-5 relative">
          <div class="relative aspect-[4/5] rounded-sm overflow-hidden shadow-xl border-4 border-white">
            <img
              src="https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1000&q=80"
              alt="Dedikasi Kuliner FindSeleroo"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Overlapping small accent card -->
          <div class="absolute -bottom-6 -right-6 hidden sm:block bg-[#263A30] text-[#F4EBDD] p-6 max-w-xs rounded-sm shadow-xl border border-[#B78B5B]/30">
            <span class="text-[0.68rem] tracking-widest uppercase text-[#B78B5B] font-semibold block mb-1">Citarasa Semarang</span>
            <p class="font-serif text-lg font-bold">Kelezatan Tradisi Nusantara dengan Standar Modern</p>
          </div>
        </div>

        <!-- Right: Text Content -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block">Tentang FindSeleroo</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#263A30] leading-tight">
              Menghadirkan Kelezatan yang Mempererat Setiap Pertemuan
            </h2>
          </div>

          <p class="text-base text-[#292720]/80 leading-relaxed">
            Berawal dari komitmen menyajikan hidangan bercita rasa otentik dengan kebersihan terjamin, <strong>FindSeleroo</strong> hadir di Kota Semarang untuk memenuhi berbagai kebutuhan konsumsi — mulai dari santapan harian praktis untuk keluarga, nasi bento profesional untuk jamuan kantor, hingga prasmanan lengkap perayaan istimewa.
          </p>

          <!-- 4 Pillars Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
            <div class="border-l-2 border-[#B78B5B] pl-4 space-y-1">
              <h4 class="font-serif text-lg font-bold text-[#263A30]">Bahan Baku Segar</h4>
              <p class="text-xs text-[#292720]/75 leading-relaxed">
                Dipilih setiap hari dari pemasok lokal terpercaya untuk menjamin nutrisi dan kesegaran rasa.
              </p>
            </div>

            <div class="border-l-2 border-[#B78B5B] pl-4 space-y-1">
              <h4 class="font-serif text-lg font-bold text-[#263A30]">Resep Nusantara Otentik</h4>
              <p class="text-xs text-[#292720]/75 leading-relaxed">
                Diolah dengan rempah pilihan warisan nusantara menghasilkan profil rasa yang gurih meresap.
              </p>
            </div>

            <div class="border-l-2 border-[#B78B5B] pl-4 space-y-1">
              <h4 class="font-serif text-lg font-bold text-[#263A30]">Solusi Boga Fleksibel</h4>
              <p class="text-xs text-[#292720]/75 leading-relaxed">
                Porsi dan komposisi menu dapat disesuaikan dengan kebutuhan acara dan preferensi tamu Anda.
              </p>
            </div>

            <div class="border-l-2 border-[#B78B5B] pl-4 space-y-1">
              <h4 class="font-serif text-lg font-bold text-[#263A30]">Layanan Profesional</h4>
              <p class="text-xs text-[#292720]/75 leading-relaxed">
                Kemasan rapi berstandar higienis, pengantaran tepat waktu, dan koordinasi yang mudah.
              </p>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-6">
            <a
              href="/paket"
              class="inline-flex items-center gap-2 text-sm font-semibold text-[#263A30] hover:text-[#B78B5B] transition-colors group"
            >
              <span>Pelajari seluruh paket catering kami</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href={pricelistWaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#B78B5B] hover:underline font-medium"
            >
              Unduh Pricelist / Brosur via WhatsApp →
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- 3. CATERING SERVICES -->
  <section class="py-20 bg-white border-y border-[#263A30]/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block">Layanan Utama</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#263A30]">
          Solusi Catering Lengkap untuk Setiap Acara
        </h2>
        <p class="text-sm sm:text-base text-[#292720]/75">
          Dari santap siang harian hingga jamuan akbar, FindSeleroo siap memberikan pengalaman kuliner terbaik.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {SERVICES_LIST.map((service) => (
          <div class="flex flex-col bg-[#F4EBDD]/50 border border-[#263A30]/10 rounded-sm overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="aspect-[4/3] overflow-hidden relative">
              <img
                src={service.image}
                alt={service.title}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="font-serif text-xl font-bold text-[#263A30] mb-2">{service.title}</h3>
              <p class="text-xs text-[#292720]/80 leading-relaxed mb-4 flex-grow">
                {service.shortDesc}
              </p>
              <ul class="space-y-1.5 mb-6 text-[0.78rem] text-[#292720]/70">
                {service.features.slice(0, 3).map((f) => (
                  <li class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B78B5B]"></span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <a
                href={service.link}
                class="inline-flex items-center justify-center w-full py-2.5 px-4 bg-[#263A30] text-[#F4EBDD] hover:bg-[#1a2820] text-xs font-semibold tracking-wider uppercase transition-colors rounded-xs"
              >
                Lihat Paket
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. BEST SELLER MENU -->
  <section class="py-20 sm:py-28 bg-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
        <div>
          <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block mb-2">Menu Favorit Pilihan</span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#263A30]">
            Hidangan Best Seller FindSeleroo
          </h2>
          <p class="text-sm text-[#292720]/75 mt-2 max-w-xl">
            Tiga menu andalan yang paling banyak dipesan untuk acara keluarga, makan siang kantor, dan syukuran.
          </p>
        </div>
        <div>
          <a
            href="/menu"
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-[#263A30] text-[#263A30] hover:bg-[#263A30] hover:text-[#F4EBDD] text-sm font-semibold tracking-wide transition-all rounded-xs"
          >
            <span>Buka Semua Menu</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {BEST_SELLERS.map((item) => {
          const itemWaUrl = getWhatsAppUrl('menu', { name: item.name });
          return (
            <div class="bg-white border border-[#263A30]/10 rounded-sm overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
              <div class="aspect-[4/3] overflow-hidden relative">
                <img
                  src={item.image}
                  alt={item.name}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 bg-[#B78B5B] text-[#263A30] px-3 py-1 text-[0.68rem] font-bold tracking-wider uppercase rounded-xs shadow">
                  Best Seller
                </span>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h3 class="font-serif text-xl font-bold text-[#263A30]">{item.name}</h3>
                </div>
                <div class="text-lg font-bold text-[#B78B5B] mb-3">
                  {item.formattedPrice} <span class="text-xs font-normal text-[#292720]/60">/ porsi</span>
                </div>
                <p class="text-xs text-[#292720]/75 leading-relaxed mb-6 flex-grow">
                  {item.description}
                </p>
                <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                  <span class="text-[0.72rem] text-[#292720]/60">Min. order 10 pax</span>
                  <a
                    href={itemWaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#263A30] hover:bg-[#1a2820] text-[#F4EBDD] text-xs font-medium tracking-wide rounded-xs transition-colors"
                  >
                    <span>Pesan via WA</span>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- 5. WHY CHOOSE FINDSELEROO -->
  <section class="py-20 bg-[#263A30] text-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block">Mengapa FindSeleroo</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#F4EBDD]">
          Dedikasi Kualitas di Setiap Sajian
        </h2>
        <p class="text-sm text-[#F4EBDD]/80">
          Kami menjamin transparansi, kesegaran bahan, dan kenyamanan pemesanan untuk setiap pelanggan di Semarang.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {WHY_US_LIST.map((item, idx) => (
          <div class="bg-[#1e2f26] p-8 border border-[#B78B5B]/20 rounded-sm relative">
            <span class="text-3xl font-serif font-bold text-[#B78B5B]/30 mb-4 block">0{idx + 1}</span>
            <h3 class="font-serif text-lg font-bold text-[#F4EBDD] mb-3">{item.title}</h3>
            <p class="text-xs text-[#F4EBDD]/75 leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 6. FEATURED PACKAGES -->
  <section class="py-20 sm:py-28 bg-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
        <div>
          <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block mb-2">Pilihan Paket Terpopuler</span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#263A30]">
            Paket Catering Pilihan Pelanggan
          </h2>
          <p class="text-sm text-[#292720]/75 mt-2 max-w-xl">
            Solusi praktis dengan komposisi lauk lengkap dan harga terukur. Minimum pemesanan 10 pax.
          </p>
        </div>
        <div>
          <a
            href="/paket"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#263A30] hover:text-[#B78B5B] transition-colors"
          >
            <span>Coba Kalkulator Anggaran di Halaman Paket</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredPackages.map((pkg) => {
          const pkgWaUrl = getWhatsAppUrl('package', { name: pkg.name, pax: pkg.minPax });
          return (
            <div class="bg-white border border-[#263A30]/10 rounded-sm overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
              <div class="aspect-[16/10] overflow-hidden relative">
                <img
                  src={pkg.image}
                  alt={pkg.name}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 bg-[#263A30] text-[#F4EBDD] px-2.5 py-1 text-[0.68rem] font-medium tracking-wider uppercase rounded-xs">
                  {pkg.categoryLabel}
                </span>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="font-serif text-xl font-bold text-[#263A30] mb-2">{pkg.name}</h3>
                <div class="text-2xl font-serif font-bold text-[#B78B5B] mb-1">
                  {pkg.formattedPrice}
                  <span class="text-xs font-sans font-normal text-[#292720]/60"> / pax</span>
                </div>
                <p class="text-[0.72rem] text-[#292720]/60 mb-4">Min. {pkg.minPax} pax</p>
                <p class="text-xs text-[#292720]/75 leading-relaxed mb-6">
                  {pkg.description}
                </p>

                <div class="bg-[#F4EBDD]/40 p-3.5 rounded-xs mb-6">
                  <span class="text-[0.68rem] tracking-wider uppercase font-semibold text-[#263A30] block mb-2">Termasuk dalam paket:</span>
                  <ul class="space-y-1 text-xs text-[#292720]/80">
                    {pkg.includedItems.slice(0, 4).map((item) => (
                      <li class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-[#B78B5B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="truncate">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-auto">
                  <a
                    href={pkgWaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center w-full py-3 bg-[#263A30] hover:bg-[#1a2820] text-[#F4EBDD] text-xs font-semibold tracking-wider uppercase transition-colors rounded-xs shadow"
                  >
                    Konsultasi Paket Ini
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- 7. TESTIMONIALS (Clearly labeled placeholder content) -->
  <section class="py-20 bg-white border-y border-[#263A30]/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block">Pengalaman Pelanggan</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#263A30]">
          Kata Mereka tentang FindSeleroo
        </h2>
        <p class="text-xs text-[#292720]/60 italic">
          (Kutipan pengalaman pelanggan simulasi/placeholder untuk keperluan tata letak desain dan akan diperbarui berkala)
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {TESTIMONIALS_LIST.map((t) => (
          <div class="bg-[#F4EBDD]/40 border border-[#263A30]/10 p-8 rounded-sm flex flex-col justify-between relative">
            <svg class="w-8 h-8 text-[#B78B5B]/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <p class="text-xs sm:text-sm text-[#292720]/80 italic leading-relaxed mb-6">
              "{t.quote}"
            </p>
            <div class="pt-4 border-t border-[#263A30]/10">
              <p class="font-serif font-bold text-sm text-[#263A30]">{t.clientType}</p>
              <p class="text-[0.72rem] text-[#B78B5B] font-medium mt-0.5">{t.event}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 8. CLOSING CTA & COVERAGE -->
  <section class="py-20 sm:py-28 bg-[#263A30] text-[#F4EBDD] relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
      <span class="inline-block px-3.5 py-1 bg-[#B78B5B]/20 text-[#B78B5B] border border-[#B78B5B]/40 text-xs font-semibold tracking-widest uppercase rounded-xs">
        Mulai Rencanakan Hidangan Anda
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
        Siap Menyajikan Hidangan Terbaik untuk Momen Anda?
      </h2>
      <p class="text-base text-[#F4EBDD]/80 max-w-xl mx-auto leading-relaxed">
        Konsultasikan kebutuhan catering Anda bersama FindSeleroo. Tim kami siap membantu menyusun komposisi hidangan terbaik sesuai selera dan anggaran.
      </p>
      
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={generalWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-8 py-4 bg-[#B78B5B] hover:bg-[#a67c4e] text-[#263A30] font-bold text-sm tracking-wide rounded-xs shadow-lg transition-all"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.45 1.014 1.157 1.644.912.812 1.637 1.059 1.868 1.175.231.116.368.102.506-.058.138-.16.592-.693.75-0.93.159-.237.318-.198.535-.116.217.082 1.372.646 1.609.764.237.118.395.176.453.275.058.099.058.577-.086.982z"/>
          </svg>
          <span>Konsultasi via WhatsApp</span>
        </a>
        <a
          href="/kontak"
          class="inline-flex items-center justify-center px-8 py-4 bg-transparent hover:bg-white/10 text-[#F4EBDD] border border-[#F4EBDD]/40 text-sm font-medium tracking-wide rounded-xs transition-colors"
        >
          Informasi Kontak & FAQ
        </a>
      </div>

      <!-- Semarang Delivery Area Micro Badges -->
      <div class="pt-8 border-t border-[#F4EBDD]/15">
        <p class="text-xs text-[#B78B5B] uppercase tracking-wider font-semibold mb-2">
          Area Layanan Pengantaran Semarang & Sekitarnya:
        </p>
        <p class="text-[0.75rem] text-[#F4EBDD]/70 max-w-2xl mx-auto leading-relaxed">
          {SEMARANG_DISTRICTS.join(' • ')}
        </p>
      </div>

    </div>
  </section>
</Layout>

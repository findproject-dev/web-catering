---
import Layout from '../layouts/Layout.astro';
import { BRAND_INFO, FAQ_LIST, SEMARANG_DISTRICTS } from '../data/cateringData';
import { getWhatsAppUrl } from '../utils/whatsapp';

const generalWaUrl = getWhatsAppUrl('general');
const pricelistWaUrl = `https://wa.me/${BRAND_INFO.whatsappNumber}?text=${encodeURIComponent('Halo FindSeleroo, saya ingin meminta file brosur dan pricelist lengkap catering untuk referensi acara/kantor saya. Terima kasih!')}`;
---

<Layout
  title="Kontak & Pemesanan — FindSeleroo Catering Semarang"
  description="Hubungi FindSeleroo Catering Semarang via WhatsApp untuk konsultasi pesanan boga, nasi box kantor, prasmanan pernikahan, dan catering harian keluarga."
  currentPath="/kontak"
>
  <!-- Page Header -->
  <section class="bg-[#263A30] text-[#F4EBDD] py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-3 py-1 bg-[#B78B5B]/20 border border-[#B78B5B]/40 text-[#B78B5B] text-xs font-semibold tracking-widest uppercase mb-4 rounded-xs">
        Komunikasi & Konsultasi
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight mb-4">
        Hubungi FindSeleroo
      </h1>
      <p class="text-sm sm:text-base text-[#F4EBDD]/80 max-w-2xl mx-auto leading-relaxed">
        Kami siap mendengarkan rencana acara Anda dan memberikan rekomendasi hidangan terbaik. Layanan pemesanan utama dilayani melalui WhatsApp resmi kami.
      </p>

      <!-- Pricelist Request CTA -->
      <div class="mt-6">
        <a
          href={pricelistWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#B78B5B] hover:bg-[#a67c4e] text-[#263A30] text-xs font-bold tracking-wide rounded-xs shadow transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Minta Pricelist PDF via WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Ordering Steps Section (Cara Pemesanan) -->
  <section class="py-16 bg-white border-b border-[#263A30]/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block">Panduan Singkat</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#263A30]">
          4 Langkah Mudah Memesan Catering
        </h2>
        <p class="text-xs sm:text-sm text-[#292720]/75">
          Proses pemesanan transparan tanpa kerumitan untuk kenyamanan Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-[#F4EBDD]/40 p-6 rounded-sm border border-[#263A30]/10 relative">
          <span class="text-3xl font-serif font-bold text-[#B78B5B] block mb-2">01</span>
          <h3 class="font-serif font-bold text-[#263A30] text-base mb-1">Pilih Menu / Paket</h3>
          <p class="text-xs text-[#292720]/75 leading-relaxed">
            Pilih menu favorit atau paket yang sesuai dengan tema acara Anda di katalog website.
          </p>
        </div>

        <div class="bg-[#F4EBDD]/40 p-6 rounded-sm border border-[#263A30]/10 relative">
          <span class="text-3xl font-serif font-bold text-[#B78B5B] block mb-2">02</span>
          <h3 class="font-serif font-bold text-[#263A30] text-base mb-1">Konsultasi WhatsApp</h3>
          <p class="text-xs text-[#292720]/75 leading-relaxed">
            Klik tombol WhatsApp untuk terhubung dengan staf FindSeleroo beserta rincian jumlah pax & tanggal acara.
          </p>
        </div>

        <div class="bg-[#F4EBDD]/40 p-6 rounded-sm border border-[#263A30]/10 relative">
          <span class="text-3xl font-serif font-bold text-[#B78B5B] block mb-2">03</span>
          <h3 class="font-serif font-bold text-[#263A30] text-base mb-1">Konfirmasi & DP</h3>
          <p class="text-xs text-[#292720]/75 leading-relaxed">
            Setelah rincian harga dan menu disetujui, konfirmasi pesanan dengan pembayaran Down Payment (DP).
          </p>
        </div>

        <div class="bg-[#F4EBDD]/40 p-6 rounded-sm border border-[#263A30]/10 relative">
          <span class="text-3xl font-serif font-bold text-[#B78B5B] block mb-2">04</span>
          <h3 class="font-serif font-bold text-[#263A30] text-base mb-1">Pengantaran Tepat Waktu</h3>
          <p class="text-xs text-[#292720]/75 leading-relaxed">
            Pesanan dimasak segar dan diantar tepat waktu langsung ke lokasi acara Anda di wilayah Semarang.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Contact Details & Interactive WhatsApp Form -->
  <section class="py-16 sm:py-24 bg-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Contact Information & Location -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block mb-2">Informasi Operasional</span>
            <h2 class="font-serif text-3xl font-bold text-[#263A30]">
              Kantor & Area Layanan
            </h2>
            <p class="text-xs sm:text-sm text-[#292720]/75 mt-2 leading-relaxed">
              FindSeleroo berbasis di Kota Semarang dan melayani seluruh wilayah Semarang dan sekitarnya.
            </p>
          </div>

          <div class="space-y-4">
            <!-- Location card -->
            <div class="bg-white p-5 rounded-sm border border-[#263A30]/10 flex items-start gap-4 shadow-xs">
              <div class="p-2.5 bg-[#263A30]/10 text-[#263A30] rounded-xs shrink-0">
                <svg class="w-5 h-5 text-[#B78B5B]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif font-bold text-[#263A30] text-sm">Kota Operasional</h3>
                <p class="text-xs text-[#292720]/80 mt-0.5">{BRAND_INFO.location}</p>
                <p class="text-[0.72rem] text-[#292720]/60 mt-1 italic leading-tight">
                  {BRAND_INFO.addressPlaceholder}
                </p>
              </div>
            </div>

            <!-- Operating Hours card -->
            <div class="bg-white p-5 rounded-sm border border-[#263A30]/10 flex items-start gap-4 shadow-xs">
              <div class="p-2.5 bg-[#263A30]/10 text-[#263A30] rounded-xs shrink-0">
                <svg class="w-5 h-5 text-[#B78B5B]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif font-bold text-[#263A30] text-sm">Jam Pelayanan Konsultasi</h3>
                <p class="text-xs text-[#292720]/80 mt-0.5 leading-relaxed">{BRAND_INFO.operatingHours}</p>
              </div>
            </div>

            <!-- WhatsApp direct action card -->
            <div class="bg-[#263A30] text-[#F4EBDD] p-5 rounded-sm border border-[#B78B5B]/30 flex items-start gap-4 shadow-md">
              <div class="p-2.5 bg-[#25D366]/20 text-[#25D366] rounded-xs shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.45 1.014 1.157 1.644.912.812 1.637 1.059 1.868 1.175.231.116.368.102.506-.058.138-.16.592-.693.75-0.93.159-.237.318-.198.535-.116.217.082 1.372.646 1.609.764.237.118.395.176.453.275.058.099.058.577-.086.982z"/>
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="font-serif font-bold text-sm">Konsultasi Cepat WhatsApp</h3>
                <p class="text-xs text-[#F4EBDD]/75 mt-0.5">Respon cepat dari customer representative kami</p>
                <div class="mt-3">
                  <a
                    href={generalWaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#25D366] hover:bg-[#1fa951] text-white text-xs font-semibold rounded-xs shadow transition-colors"
                  >
                    Buka WhatsApp Sekarang
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Semarang Delivery Coverage Area Badge Section -->
          <div class="bg-white p-5 rounded-sm border border-[#263A30]/10 shadow-xs">
            <h3 class="font-serif font-bold text-[#263A30] text-sm mb-2">Cakupan Pengantaran di Semarang:</h3>
            <div class="flex flex-wrap gap-1.5">
              {SEMARANG_DISTRICTS.map((d) => (
                <span class="px-2.5 py-1 bg-[#F4EBDD]/60 text-[#263A30] text-[0.68rem] font-medium rounded-xs border border-[#263A30]/10">
                  {d}
                </span>
              ))}
            </div>
          </div>

          <!-- Google Maps Embed Placeholder -->
          <div class="bg-white p-2 rounded-sm border border-[#263A30]/10 shadow-xs">
            <div class="aspect-[16/9] w-full rounded-xs overflow-hidden">
              <iframe
                title="Peta Lokasi FindSeleroo Semarang"
                src={BRAND_INFO.mapsEmbedUrl}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
            <p class="text-[0.68rem] text-center text-[#292720]/60 py-2">
              Area layanan mencakup seluruh penjuru Kota Semarang & sekitarnya.
            </p>
          </div>

        </div>

        <!-- Right: Fast Inquiry Form Builder for WhatsApp -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 sm:p-10 rounded-sm border border-[#263A30]/10 shadow-lg">
            
            <div class="mb-8">
              <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block mb-1">Kalkulator Pesan Singkat</span>
              <h3 class="font-serif text-2xl font-bold text-[#263A30]">Formulir Konsultasi Acara</h3>
              <p class="text-xs text-[#292720]/75 mt-1 leading-relaxed">
                Isi rincian di bawah ini untuk menghasilkan pesan WhatsApp terstruktur yang langsung ditujukan kepada tim kami.
              </p>
            </div>

            <form id="inquiry-form" data-wa-number={BRAND_INFO.whatsappNumber} class="space-y-5">
              <div>
                <label for="client-name" class="block text-xs font-semibold uppercase tracking-wider text-[#263A30] mb-1">
                  Nama Anda / Instansi *
                </label>
                <input
                  type="text"
                  id="client-name"
                  required
                  placeholder="Contoh: Ibu Rina / PT Maju Sejahtera"
                  class="w-full px-4 py-2.5 bg-[#F4EBDD]/20 border border-[#263A30]/20 rounded-xs text-sm text-[#292720] focus:outline-none focus:border-[#263A30] focus:ring-1 focus:ring-[#263A30]"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="event-type" class="block text-xs font-semibold uppercase tracking-wider text-[#263A30] mb-1">
                    Jenis Kebutuhan Acara *
                  </label>
                  <select
                    id="event-type"
                    class="w-full px-4 py-2.5 bg-[#F4EBDD]/20 border border-[#263A30]/20 rounded-xs text-sm text-[#292720] focus:outline-none focus:border-[#263A30] focus:ring-1 focus:ring-[#263A30]"
                  >
                    <option value="Catering Harian">Catering Harian</option>
                    <option value="Family Dining / Arisan">Family Dining / Arisan</option>
                    <option value="Nasi Box Kantor / Meeting">Nasi Box Kantor / Meeting</option>
                    <option value="Event Gathering / Syukuran">Event Gathering / Syukuran</option>
                    <option value="Prasmanan Pernikahan">Prasmanan Pernikahan</option>
                    <option value="Snack Box & Coffee Break">Snack Box & Coffee Break</option>
                    <option value="Custom Catering Khusus">Custom Catering Khusus</option>
                  </select>
                </div>

                <div>
                  <label for="pax-count" class="block text-xs font-semibold uppercase tracking-wider text-[#263A30] mb-1">
                    Estimasi Jumlah Pax (Min. 10) *
                  </label>
                  <input
                    type="number"
                    id="pax-count"
                    min="10"
                    value="25"
                    required
                    class="w-full px-4 py-2.5 bg-[#F4EBDD]/20 border border-[#263A30]/20 rounded-xs text-sm text-[#292720] focus:outline-none focus:border-[#263A30] focus:ring-1 focus:ring-[#263A30]"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="event-date" class="block text-xs font-semibold uppercase tracking-wider text-[#263A30] mb-1">
                    Rencana Tanggal Acara
                  </label>
                  <input
                    type="date"
                    id="event-date"
                    class="w-full px-4 py-2.5 bg-[#F4EBDD]/20 border border-[#263A30]/20 rounded-xs text-sm text-[#292720] focus:outline-none focus:border-[#263A30] focus:ring-1 focus:ring-[#263A30]"
                  />
                </div>

                <div>
                  <label for="event-location" class="block text-xs font-semibold uppercase tracking-wider text-[#263A30] mb-1">
                    Lokasi / Kecamatan di Semarang
                  </label>
                  <input
                    type="text"
                    id="event-location"
                    placeholder="Contoh: Candisari / Banyumanik"
                    class="w-full px-4 py-2.5 bg-[#F4EBDD]/20 border border-[#263A30]/20 rounded-xs text-sm text-[#292720] focus:outline-none focus:border-[#263A30] focus:ring-1 focus:ring-[#263A30]"
                  />
                </div>
              </div>

              <div>
                <label for="notes" class="block text-xs font-semibold uppercase tracking-wider text-[#263A30] mb-1">
                  Catatan Tambahan / Menu Khusus
                </label>
                <textarea
                  id="notes"
                  rows="3"
                  placeholder="Contoh: Preferensi rendang & ayam bakar, tidak terlalu pedas, kemasan bento box eksklusif..."
                  class="w-full px-4 py-2.5 bg-[#F4EBDD]/20 border border-[#263A30]/20 rounded-xs text-sm text-[#292720] focus:outline-none focus:border-[#263A30] focus:ring-1 focus:ring-[#263A30]"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full py-4 bg-[#263A30] hover:bg-[#1a2820] text-[#F4EBDD] font-bold text-sm tracking-wide rounded-xs shadow-md transition-all flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.45 1.014 1.157 1.644.912.812 1.637 1.059 1.868 1.175.231.116.368.102.506-.058.138-.16.592-.693.75-0.93.159-.237.318-.198.535-.116.217.082 1.372.646 1.609.764.237.118.395.176.453.275.058.099.058.577-.086.982z"/>
                  </svg>
                  <span>Kirim Rincian Konsultasi ke WhatsApp</span>
                </button>
              </div>

              <p class="text-[0.7rem] text-center text-[#292720]/60 leading-tight">
                Tombol akan membuka WhatsApp resmi FindSeleroo dengan pesan yang sudah terisi otomatis sesuai formulir di atas.
              </p>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- FAQ Section (Pertanyaan Umum) -->
  <section class="py-20 bg-white border-t border-[#263A30]/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-14 space-y-2">
        <span class="text-xs font-semibold tracking-widest uppercase text-[#B78B5B] block">Informasi Lengkap</span>
        <h2 class="font-serif text-3xl font-bold text-[#263A30]">
          Pertanyaan yang Sering Diajukan (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-[#292720]/75">
          Jawaban seputar pemesanan, minimum kuantitas, pengantaran, dan penyesuaian menu.
        </p>
      </div>

      <div class="space-y-4" id="faq-accordion">
        {FAQ_LIST.map((faq, idx) => (
          <div class="border border-[#263A30]/15 rounded-sm overflow-hidden bg-[#F4EBDD]/20">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-4.5 text-left flex items-center justify-between gap-4 font-serif font-bold text-[#263A30] text-base hover:bg-[#F4EBDD]/50 transition-colors"
              aria-expanded="false"
            >
              <span>{faq.question}</span>
              <svg class="faq-icon w-5 h-5 text-[#B78B5B] shrink-0 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-content hidden px-6 pb-5 pt-1 text-xs sm:text-sm text-[#292720]/80 leading-relaxed border-t border-[#263A30]/10">
              {faq.answer}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<script>
  // Fast Inquiry WhatsApp Form submit
  const inquiryForm = document.getElementById('inquiry-form');
  if (inquiryForm) {
    inquiryForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('client-name') as HTMLInputElement).value;
      const eventType = (document.getElementById('event-type') as HTMLSelectElement).value;
      const pax = (document.getElementById('pax-count') as HTMLInputElement).value;
      const date = (document.getElementById('event-date') as HTMLInputElement).value;
      const loc = (document.getElementById('event-location') as HTMLInputElement).value;
      const notes = (document.getElementById('notes') as HTMLTextAreaElement).value;

      let msg = `Halo FindSeleroo, saya ingin berkonsultasi mengenai pemesanan catering:\n\n`;
      msg += `• Nama/Instansi: ${name}\n`;
      msg += `• Jenis Acara: ${eventType}\n`;
      msg += `• Jumlah: ${pax} pax\n`;
      if (date) msg += `• Tanggal Acara: ${date}\n`;
      if (loc) msg += `• Area Lokasi: ${loc}\n`;
      if (notes) msg += `• Catatan Khusus: ${notes}\n`;
      msg += `\nMohon informasi rekomendasi menu dan penawarannya. Terima kasih!`;

      const waNumber = inquiryForm.getAttribute('data-wa-number') || '6281234567890';
      const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
    });
  }

  // FAQ Accordion
  const faqToggles = document.querySelectorAll('.faq-toggle');
  faqToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');

      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      if (content) {
        content.classList.toggle('hidden');
      }
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
  });
</script>

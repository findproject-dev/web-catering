---
import Layout from '../layouts/Layout.astro';
import { GALLERY_ITEMS, BRAND_INFO } from '../data/cateringData';
import { getWhatsAppUrl } from '../utils/whatsapp';

const waUrl = getWhatsAppUrl('general');
---

<Layout
  title="Galeri Dokumentasi & Sajian — FindSeleroo Catering Semarang"
  description="Dokumentasi visual sajian catering FindSeleroo Semarang: Menu otentik nusantara, tata saji nasi bento box, kemewahan prasmanan buffet, dan aneka snack box premium."
  currentPath="/galeri"
>
  <!-- Page Header -->
  <section class="bg-[#263A30] text-[#F4EBDD] py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-3 py-1 bg-[#B78B5B]/20 border border-[#B78B5B]/40 text-[#B78B5B] text-xs font-semibold tracking-widest uppercase mb-4 rounded-xs">
        Dokumentasi Visual
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight mb-4">
        Galeri Sajian FindSeleroo
      </h1>
      <p class="text-sm sm:text-base text-[#F4EBDD]/80 max-w-2xl mx-auto leading-relaxed">
        Eksplorasi estetika hidangan dan penataan catering kami — dari hidangan lezat siap santap hingga kehangatan tata meja jamuan acara.
      </p>
    </div>
  </section>

  <!-- Filter & Masonry/Editorial Grid -->
  <section class="py-16 sm:py-20 bg-[#F4EBDD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Category Filter Tabs -->
      <div class="flex items-center justify-center mb-12">
        <div class="flex flex-wrap items-center justify-center gap-2 p-1.5 bg-white/70 border border-[#263A30]/15 rounded-sm max-w-3xl" id="gallery-filter-container">
          <button
            type="button"
            data-category="all"
            class="gal-filter-btn active px-4 py-2 text-xs sm:text-sm font-medium tracking-wide rounded-xs transition-all bg-[#263A30] text-[#F4EBDD]"
          >
            Semua Foto
          </button>
          <button
            type="button"
            data-category="menu"
            class="gal-filter-btn px-4 py-2 text-xs sm:text-sm font-medium tracking-wide rounded-xs transition-all text-[#292720] hover:bg-[#263A30]/10"
          >
            Menu Makanan
          </button>
          <button
            type="button"
            data-category="nasi-box"
            class="gal-filter-btn px-4 py-2 text-xs sm:text-sm font-medium tracking-wide rounded-xs transition-all text-[#292720] hover:bg-[#263A30]/10"
          >
            Nasi Box
          </button>
          <button
            type="button"
            data-category="prasmanan"
            class="gal-filter-btn px-4 py-2 text-xs sm:text-sm font-medium tracking-wide rounded-xs transition-all text-[#292720] hover:bg-[#263A30]/10"
          >
            Prasmanan
          </button>
          <button
            type="button"
            data-category="snack-box"
            class="gal-filter-btn px-4 py-2 text-xs sm:text-sm font-medium tracking-wide rounded-xs transition-all text-[#292720] hover:bg-[#263A30]/10"
          >
            Snack Box
          </button>
          <button
            type="button"
            data-category="event"
            class="gal-filter-btn px-4 py-2 text-xs sm:text-sm font-medium tracking-wide rounded-xs transition-all text-[#292720] hover:bg-[#263A30]/10"
          >
            Event Catering
          </button>
        </div>
      </div>

      <!-- Gallery Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery-grid">
        {GALLERY_ITEMS.map((item) => (
          <div
            class="gallery-item group relative bg-white border border-[#263A30]/10 rounded-sm overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer"
            data-item-category={item.category}
            data-full-img={item.image}
            data-title={item.title}
            data-caption={item.caption}
            data-cat-label={item.categoryLabel}
          >
            <div class="aspect-[4/3] overflow-hidden relative bg-black/5">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
                loading="lazy"
              />
              
              <!-- Category Badge -->
              <div class="absolute top-3 left-3 z-10">
                <span class="bg-[#263A30]/85 backdrop-blur-xs text-[#F4EBDD] px-2.5 py-1 text-[0.68rem] font-medium tracking-wider uppercase rounded-xs">
                  {item.categoryLabel}
                </span>
              </div>

              <!-- Overlay On Hover -->
              <div class="absolute inset-0 bg-[#263A30]/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6 text-[#F4EBDD]">
                <h3 class="font-serif text-lg font-bold mb-1 leading-snug">{item.title}</h3>
                <p class="text-xs text-[#F4EBDD]/80 line-clamp-2 leading-relaxed">{item.caption}</p>
                <div class="mt-3 flex items-center gap-1.5 text-xs text-[#B78B5B] font-medium">
                  <span>Klik untuk perbesar</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar for Accessibility -->
            <div class="p-4 sm:hidden bg-white">
              <h3 class="font-serif font-bold text-[#263A30] text-sm">{item.title}</h3>
              <p class="text-xs text-[#292720]/70 mt-1">{item.caption}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Gallery Lightbox Modal -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 bg-[#292720]/95 backdrop-blur-md hidden flex items-center justify-center p-4 sm:p-8 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Tampilan Foto Penuh"
  >
    <!-- Close button -->
    <button
      type="button"
      id="lightbox-close"
      aria-label="Tutup Tampilan Foto"
      class="absolute top-6 right-6 p-2 text-white/80 hover:text-white bg-black/40 hover:bg-black/70 rounded-full transition-colors z-50 focus:outline-none"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col bg-[#263A30] text-[#F4EBDD] rounded-sm overflow-hidden shadow-2xl border border-[#B78B5B]/30">
      <!-- Big Image -->
      <div class="relative max-h-[65vh] bg-black/40 overflow-hidden flex items-center justify-center">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[65vh] w-auto max-w-full object-contain mx-auto"
        />
      </div>

      <!-- Caption bar -->
      <div class="p-6 bg-[#263A30] border-t border-[#B78B5B]/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span id="lightbox-badge" class="text-[0.68rem] tracking-widest uppercase text-[#B78B5B] font-semibold block mb-1">
            KATEGORI
          </span>
          <h3 id="lightbox-title" class="font-serif text-xl sm:text-2xl font-bold text-[#F4EBDD]">
            Judul Dokumentasi
          </h3>
          <p id="lightbox-desc" class="text-xs sm:text-sm text-[#F4EBDD]/80 mt-1 max-w-xl leading-relaxed">
            Keterangan sajian.
          </p>
        </div>

        <div class="shrink-0">
          <a
            id="lightbox-wa-btn"
            href={waUrl}
            data-wa-number={BRAND_INFO.whatsappNumber}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#B78B5B] hover:bg-[#a67c4e] text-[#263A30] font-semibold text-xs tracking-wider uppercase rounded-xs transition-colors shadow"
          >
            <span>Tanya Sajian Ini</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.45 1.014 1.157 1.644.912.812 1.637 1.059 1.868 1.175.231.116.368.102.506-.058.138-.16.592-.693.75-0.93.159-.237.318-.198.535-.116.217.082 1.372.646 1.609.764.237.118.395.176.453.275.058.099.058.577-.086.982z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Closing Banner -->
  <section class="py-16 bg-white border-t border-[#263A30]/10">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-4">
      <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#263A30]">
        Ingin Penataan Seperti Salah Satu Dokumentasi di Atas?
      </h3>
      <p class="text-sm text-[#292720]/75 max-w-xl mx-auto leading-relaxed">
        Kirimkan tangkapan layar atau sebutkan konsep yang Anda sukai saat berkonsultasi bersama kami melalui WhatsApp.
      </p>
      <div class="pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-[#263A30] hover:bg-[#1a2820] text-[#F4EBDD] font-semibold text-xs tracking-wider uppercase rounded-xs transition-colors shadow"
        >
          Hubungi Tim FindSeleroo
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Filter functionality
  const galFilterButtons = document.querySelectorAll('.gal-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  galFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      galFilterButtons.forEach((b) => {
        b.classList.remove('bg-[#263A30]', 'text-[#F4EBDD]');
        b.classList.add('text-[#292720]');
      });
      btn.classList.add('bg-[#263A30]', 'text-[#F4EBDD]');
      btn.classList.remove('text-[#292720]');

      const selectedCategory = btn.getAttribute('data-category');

      galleryItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-item-category');
        if (selectedCategory === 'all' || itemCategory === selectedCategory) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox functionality
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxBadge = document.getElementById('lightbox-badge');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxWaBtn = document.getElementById('lightbox-wa-btn') as HTMLAnchorElement;

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const fullImg = item.getAttribute('data-full-img') || '';
      const title = item.getAttribute('data-title') || '';
      const caption = item.getAttribute('data-caption') || '';
      const catLabel = item.getAttribute('data-cat-label') || '';

      if (lightbox && lightboxImg && lightboxTitle && lightboxDesc && lightboxBadge) {
        lightboxImg.src = fullImg;
        lightboxImg.alt = title;
        lightboxTitle.textContent = title;
        lightboxDesc.textContent = caption;
        lightboxBadge.textContent = catLabel;

        if (lightboxWaBtn) {
          const waNumber = lightboxWaBtn.getAttribute('data-wa-number') || '6281234567890';
          const text = `Halo FindSeleroo, saya tertarik dengan konsep penyajian '${title}' yang ada di galeri website. Bisa dibantu informasi paket dan ketersediaannya?`;
          lightboxWaBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
        }

        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>
